   arts=[
    ("bike","The Motorcycle","44%","39%","Parked indoors, beside the fire, on a floor that cost more than the bike. It runs. It has been ridden this month. It is not furniture and he will correct you if you call it that.",[("Runs","Yes"),("Ridden","This month"),("Furniture","No")]),
    ("book","The Open Book","28%","91%","Left face-down and open, which he knows ruins a spine. Beside it a glass with an inch left in it and no coaster.",[("Position","Face-down"),("Glass","One inch"),("Coaster","Declined")]),
    ("mezzanine","The Mezzanine","72%","9%","The upper floor runs the length of the room behind glass. From up there you can see who is in the apartment without entering it, which is either hospitable or the opposite.",[("Runs","Full length"),("Balustrade","Glass"),("Sightline","Total")]),
    ("piano","The Piano","72%","88%","He played trumpet for seven years, first chair, and cannot play this at all. It is here because a room with a piano in it behaves differently from a room without one.",[("Played by him","No"),("Actual instrument","Trumpet"),("Function","Atmosphere")]),
    ("safe","The Door","91%","70%","Brass wheel, black steel, set into the wall beside the piano and not hidden behind anything. A safe nobody can see is a safe somebody goes looking for.",[("Concealed","No"),("Contents","Paper"),("Combination","One person")]),
