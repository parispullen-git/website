# ── Three Piece Entertainment ─────────────────────────────────────────
# Static site. Apache / IONOS.

# 1. No directory listings. Without this, /proposals/ would list every
#    client proposal file to anyone who visits it.
Options -Indexes

# 2. Never serve source, build, or docs files.
<FilesMatch "\.(py|pyc|md|json|log|sh|bak)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 /__pycache__
# Block AppleDouble/system junk if any slips through
<FilesMatch "^(\._|\.DS_Store)">
  Require all denied
</FilesMatch>

# 3. Force HTTPS + canonical www-less host
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://threepieceent.com/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.threepieceent\.com$ [NC]
  RewriteRule ^(.*)$ https://threepieceent.com/$1 [R=301,L]
</IfModule>

# 4. Pretty URLs — /harvey instead of /harvey.html
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 5. Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Proposals are confidential — never let them be cached or indexed downstream
  <FilesMatch "^(?!index|harvey).*\.html$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
</IfModule>

# 6. Caching — long for assets, short for pages
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg      "access plus 1 year"
  ExpiresByType image/svg+xml   "access plus 1 year"
  ExpiresByType text/css        "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html       "access plus 1 hour"
</IfModule>

# 7. Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain
</IfModule>

ErrorDocument 404 /404.html
