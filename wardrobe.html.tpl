      </div>
      <button type="button" class="cta wquick__add" id="wquick-add"><span>Add to Inquiry</span></button>
    </div>
  </div>
</div>

<div class="wtray" id="wtray" aria-hidden="true">
  <div class="wtray__inner">
    <p class="wtray__count"><b id="wtray-count">0</b> piece<span id="wtray-plural">s</span> selected</p>
    <button type="button" class="wtray__clear" id="wtray-clear">Clear</button>
    <button type="button" class="wtray__share" id="wtray-share">Share by Email</button>
    <button type="button" class="cta wtray__send" id="wtray-send"><span>Send Inquiry</span><span class="cta__arrow" aria-hidden="true">&#8594;</span></button>
  </div>
</div>

<div class="winquiry" id="winquiry" aria-hidden="true">
  <div class="winquiry__scrim" data-winquiry-close></div>
  <div class="winquiry__panel" role="dialog" aria-modal="true" aria-label="Send inquiry">
    <button class="winquiry__close" data-winquiry-close>Close &#215;</button>
    <div class="stack stack--tight">
      <p class="eyebrow">The Boutique</p>
      <h2 class="display display--h3">Send the Inquiry</h2>
      <p class="body">These pieces, your sizes if you picked them, straight to Paris for a follow-up consultation.</p>
    </div>
    <div class="winquiry__list" id="winquiry-list"></div>
    <form id="winquiry-form" novalidate>
      <div class="winquiry__field">
        <label for="wq-name">Name</label>
        <input id="wq-name" name="name" type="text" autocomplete="name" required>
      </div>
      <div class="winquiry__field" style="margin-top:var(--s4)">
        <label for="wq-email">Email</label>
        <input id="wq-email" name="email" type="email" autocomplete="email" required>
      </div>
      <div class="winquiry__field" style="margin-top:var(--s4)">
        <label for="wq-phone">Phone</label>
        <input id="wq-phone" name="phone" type="tel" autocomplete="tel" required>
      </div>
      <div class="winquiry__field" style="margin-top:var(--s4)">
        <label for="wq-notes">Notes</label>
        <textarea id="wq-notes" name="notes" rows="3" placeholder="Occasion, timeline, anything we should know before the consultation"></textarea>
      </div>
      <p class="winquiry__err" id="winquiry-err" hidden>Add your name and a valid email first.</p>
      <button type="submit" class="cta winquiry__submit" style="margin-top:var(--s5)"><span>Send to Paris</span><span class="cta__arrow" aria-hidden="true">&#8594;</span></button>
      <p class="classified" style="margin-top:var(--s3)">Opens your mail app, addressed to hello@parispullen.com. Nothing is stored on this site.</p>
    </form>
  </div>
</div>

<div class="winquiry" id="wshare" aria-hidden="true">
  <div class="winquiry__scrim" data-wshare-close></div>
  <div class="winquiry__panel" role="dialog" aria-modal="true" aria-label="Share this list">
    <button class="winquiry__close" data-wshare-close>Close &#215;</button>
    <div class="stack stack--tight">
      <p class="eyebrow">The Boutique</p>
      <h2 class="display display--h3">Share This List</h2>
      <p class="body">Send these pieces to a client or friend &#8212; straight from your mail app, to any email you choose.</p>
    </div>
    <div class="winquiry__list" id="wshare-list"></div>
    <form id="wshare-form" novalidate>
      <div class="winquiry__field">
        <label for="wsh-email">Their email</label>
        <input id="wsh-email" name="email" type="email" autocomplete="off" required>
      </div>
      <div class="winquiry__field" style="margin-top:var(--s4)">
        <label for="wsh-from">Your name <span class="classified">(optional)</span></label>
        <input id="wsh-from" name="from" type="text" autocomplete="name">
      </div>
      <div class="winquiry__field" style="margin-top:var(--s4)">
        <label for="wsh-note">Note <span class="classified">(optional)</span></label>
        <textarea id="wsh-note" name="note" rows="3" placeholder="A line or two about why these"></textarea>
      </div>
      <p class="winquiry__err" id="wshare-err" hidden>Add a valid email first.</p>
      <button type="submit" class="cta winquiry__submit" style="margin-top:var(--s5)"><span>Share List</span><span class="cta__arrow" aria-hidden="true">&#8594;</span></button>
      <p class="classified" style="margin-top:var(--s3)">Opens your mail app, addressed to whoever you enter. Nothing is stored on this site.</p>
    </form>
  </div>
</div>

