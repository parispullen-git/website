        "srcset": true,
        "layout": "pair",
        "caption": "Another frame from the same trailer drop — the in-game world doing part of the marketing on its own.",
        "alt": "A still from the official Grand Theft Auto VI trailer showing a sports car on a highway"
      }
    ],
    "video": {
