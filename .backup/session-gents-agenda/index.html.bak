<main>

<!-- ============ 01 · THE MAN ============ -->
<section class="scene scene--full" id="the-man">
  <div class="scene__media scene__media--hero">
    <img src="assets/img/hero-boardroom.jpg"
         srcset="assets/img/hero-boardroom@sm.jpg 1200w, assets/img/hero-boardroom.jpg 2048w"
         sizes="100vw"
         alt="Paris Pullen at the head of a boardroom table above the Charlotte skyline at sunset"
         data-parallax="0.07" fetchpriority="high" width="2048" height="1152">
  </div>
  <div class="scene__scrim scene__scrim--left"></div>

  <div class="wrap">
    <div class="hero__inner">
      <p class="eyebrow reveal">Charlotte / America</p>
      <h1 class="display display--mega hero__title reveal reveal-d1">Paris<br>Pullen</h1>
      <p class="eyebrow eyebrow--muted reveal reveal-d2">The Gentleman Operator</p>
      <p class="lede reveal reveal-d2">Brand development out of Charlotte, North Carolina. A fragrance, a hotel, a city guide, and a short list of clients whose work is on the walls.</p>
      <div class="hero__ctas reveal reveal-d3">
        <a class="cta" href="#penthouse"><span>Enter the Penthouse</span><span class="cta__arrow" aria-hidden="true">&#8594;</span></a>
        <a class="cta cta--ghost" href="#firm"><span>The Firm</span></a>
      </div>
    </div>
  </div>

  <div class="hero__meta">
    <div class="cue" aria-hidden="true"><span class="cue__line"></span><span class="classified">Scroll</span></div>
  </div>
</section>

<!-- ============ 02 · THE PENTHOUSE ============ -->
<section class="scene scene--pad" id="penthouse" style="background:var(--ink)">
  <div class="wrap">
    <header class="split reveal" style="align-items:end;margin-bottom:var(--s7)">
      <div class="stack stack--tight">
        <p class="eyebrow">Inside The Compliment &#183; Levels 27&#8211;28</p>
        <h2 class="display display--h2">The Penthouse</h2>
      </div>
      <div class="stack">
        <p class="lede">Seven rooms open. The rest, in time.</p>
        <p class="classified">Arrow keys &#183; the pad &#183; the elevator &#183; or swipe</p>
      </div>
    </header>

    <div class="pent reveal reveal-d1" id="pent">
      <div class="pent__stage">
        <div class="pent__track"><!-- rooms injected by penthouse.js --></div>
        <div class="pent__plate"></div>
        <nav class="pent__pad" aria-label="Move through the penthouse">
          <button class="pent__btn pent__btn--u" data-go="u" aria-label="Up a floor">&#9650;</button>
          <button class="pent__btn pent__btn--l" data-go="l" aria-label="Left">&#9664;</button>
          <i>MOVE</i>
          <button class="pent__btn pent__btn--r" data-go="r" aria-label="Right">&#9654;</button>
          <button class="pent__btn pent__btn--d" data-go="d" aria-label="Down a floor">&#9660;</button>
        </nav>
        <div class="pent__drawer" id="pent-drawer" aria-hidden="true">
          <button class="drawer__close">Close &#215;</button>
          <div class="drawer__slot"></div>
        </div>
      </div>
    </div>

    <div class="stack" style="margin-top:var(--s7)">
      <p class="eyebrow">The Elevator &#183; Every Floor</p>
      <nav class="pent-elevator directory" id="pent-elevator" aria-label="All floors"></nav>
    </div>

    <div class="rooms reveal reveal-d2" style="margin-top:var(--s6)">
      <a class="room-btn" href="#balcony">The Balcony</a>
    </div>
  </div>
</section>

<!-- ============ THE ROOM POPUP — full-bleed room viewer ============ -->
<div class="room-popup" id="room-popup" aria-hidden="true">
  <button type="button" class="room-popup__close" data-room-popup-close aria-label="Close">Close &#215;</button>
  <nav class="popup-elevator" id="popup-elevator" aria-label="Switch floor"></nav>
  <div class="room-pager" id="popup-pager" data-room-pager>
    <div class="room-pager__viewport" id="popup-pager-viewport" data-room-pager-viewport><!-- rooms injected by penthouse.js --></div>
    <button type="button" class="room-pager__nav room-pager__nav--prev" data-room-pager-prev aria-label="Previous room"><span aria-hidden="true">&#8249;</span></button>
    <button type="button" class="room-pager__nav room-pager__nav--next" data-room-pager-next aria-label="Next room"><span aria-hidden="true">&#8250;</span></button>
  </div>
</div>

<!-- ============ 03 · THE BALCONY — CITY GUIDE ============ -->
<section class="cityscape" id="balcony">
  <div class="cityscape__head reveal">
    <p class="eyebrow">The Gentleman&#8217;s City Guide</p>
    <h2 class="display display--h2" style="margin-block:var(--s3)">Charlotte, from the balcony.</h2>
    <p class="lede">Thirteen districts, each with its own hours, its own dress code and its own reason to go. Select one, and the venues worth knowing come up with it &#8212; select a venue, and it opens.</p>
  </div>

  <div class="cityscape__surface reveal reveal-d1">
    <div class="cityplate">
      <img src="assets/img/citymap-plate.jpg"
           srcset="assets/img/citymap-plate@sm.jpg 1300w, assets/img/citymap-plate.jpg 2600w"
           sizes="100vw" alt="Aerial map of Charlotte with district boundaries"
           loading="lazy" width="2600" height="1463">
      <div class="cityplate__scrim"></div>
      <svg class="citymap-svg" id="citymap" viewBox="0 0 2000 1125"
           role="group" aria-label="Charlotte districts">
        <!-- chrome and districts injected by city.js -->
      </svg>
      <!-- venue hotspots for the selected district injected by city-explorer.js -->
    </div>
  </div>

  <div class="cityhud reveal reveal-d2">
    <div class="cityread" id="cityread"></div>
    <p class="classified" style="margin-top:var(--s4)">Hover or tab across the city &#183; select a venue to open it</p>
    <div class="rooms" style="margin-top:var(--s5)">
      <a class="room-btn" href="charlotte.html">The full Charlotte guide</a>
    </div>
  </div>
</section>

<!-- Condensed venue preview for this homepage widget -- mirrors #pent-drawer's
     role but opens the smaller #cityquick drawer, since the full vquick
     drawer's data only exists on charlotte.html itself. See
     assets/js/city-explorer.js. -->
<div class="vquick" id="cityquick" aria-hidden="true">
  <div class="vquick__scrim" data-cityquick-close></div>
  <div class="vquick__panel" role="dialog" aria-modal="true" aria-label="Venue preview">
    <button class="vquick__close" data-cityquick-close aria-label="Close">&#215;</button>
    <div class="vquick__body" style="padding-top:var(--s8)">
      <p class="vquick__cat" id="cityquick-cat"></p>
      <h3 class="vquick__name" id="cityquick-name"></h3>
      <p class="body vquick__desc" id="cityquick-note"></p>
      <div class="vquick__actions">
        <a class="cta" id="cityquick-link" href="charlotte.html"><span>View Full Listing</span><span class="cta__arrow" aria-hidden="true">&#8594;</span></a>
        <a class="cta cta--ghost" id="cityquick-all" href="charlotte.html"><span>All Charlotte Listings</span></a>
      </div>
    </div>
  </div>
</div>

<!-- ============ 04 · UR WELCOME ============ -->
<section id="fragrance">
  <div class="vault reveal" id="vault">
      <div class="vault__plate">
        <img src="assets/img/vault.jpg"
             srcset="assets/img/vault@sm.jpg 1200w, assets/img/vault.jpg 2400w"
             sizes="(max-width:980px) 100vw, 58vw"
             alt="The UR Welcome reserve bottle under glass inside the vault"
             loading="lazy" width="2400" height="1348">
        <button class="vault__node" aria-label="Open the UR Welcome reserve">
          <span class="vault__ping" aria-hidden="true"></span>
          <span class="vault__ping" aria-hidden="true"></span>
          <span class="vault__core" aria-hidden="true"></span>
        </button>
      </div>

      <div class="vault__panel">

        <div class="vault__step is-on" data-step="intro">
          <p class="eyebrow">Vault &#183; Level S</p>
          <h3 class="display display--h3">Under glass.</h3>
          <p class="body">One hundred bottles were made by hand. Ninety-nine went out. The first stayed here, lit, behind an inch of glass, because a house that sells access ought to keep something it will not sell.</p>
          <p class="classified">Select the bottle to open the file</p>
        </div>

        <div class="vault__step" data-step="product">
          <p class="eyebrow">UR Welcome</p>
          <h3 class="display display--h3">Exclusive Reserve</h3>
          <p class="body">A hundred percent oil, mixed by hand in batches too small to be a business. It does not shout on arrival &#8212; it warms over an hour, settles into the skin, and stays on a collar for two days.</p>
          <dl class="vault__edition">
            <div><dt>Edition</dt><dd>001 / 100</dd></div>
            <div><dt>Format</dt><dd>Oil, 30ml</dd></div>
            <div><dt>Wear</dt><dd>8&#8211;10 hours</dd></div>
            <div><dt>Price</dt><dd>$240</dd></div>
          </dl>
          <p class="body" style="font-size:var(--t-label)">Bergamot and black pepper, into leather and tobacco flower, down to oud, vanilla and amber.</p>
          <div class="hero__ctas">
            <span class="cta vault__buy" aria-disabled="true"><span>Buy now</span></span>
            <span class="vault__soldout">Sold out</span>
          </div>
          <p class="body" style="font-size:var(--t-label)">The next hundred have not been mixed yet. When they are, the reserve list is told first &#8212; and it is told before anyone else.</p>
          <a class="cta" href="#" data-goto="list" style="justify-self:start"><span>Join the reserve list</span><span class="cta__arrow" aria-hidden="true">&#8594;</span></a>
        </div>

        <div class="vault__step" data-step="list">
          <p class="eyebrow">The Reserve List</p>
          <h3 class="display display--h3">Tell me where to find you.</h3>
          <p class="body">Two fields. You will hear from me when the next hundred are ready, and not about anything else.</p>
          <form class="vault__form" novalidate>
            <div class="vault__field">
              <label for="ur-name">Name</label>
              <input id="ur-name" name="name" type="text" autocomplete="name" spellcheck="false" required>
            </div>
            <div class="vault__field">
              <label for="ur-email">Email</label>
              <input id="ur-email" name="email" type="email" autocomplete="email" spellcheck="false" required>
            </div>
            <p class="vault__err" role="alert"></p>
            <button class="cta" type="submit" style="justify-self:start"><span>Put me on the list</span><span class="cta__arrow" aria-hidden="true">&#8594;</span></button>
          </form>
          <p class="vault__small">No list is sold, shared or rented. Four letters a year at the very most, and usually fewer.</p>
          <a class="link-under" href="#" data-goto="product">Back to the bottle</a>
        </div>

        <div class="vault__step" data-step="thanks">
          <p class="eyebrow">You are on it</p>
          <h3 class="display display--h3">Thank you, <span data-greet>friend</span>.</h3>
          <div class="vault__note">
            <p>Most people find out about a thing after it has already gone. That is usually the point of the thing. This is the exception I make.</p>
            <p>When the next hundred are mixed you will hear from me before the site does, before the shop does, and before anybody who found out about it from somebody else. You will get a number to choose from and a few days to decide.</p>
            <p>Until then it stays under glass, and you have my word that nothing else lands in your inbox.</p>
            <p class="vault__sign">&#8212; Paris</p>
          </div>
          <p class="vault__small" data-caveat></p>
          <a class="link-under" href="#" data-goto="product">Back to the bottle</a>
        </div>

      </div>
    </div>
</section>

<!-- ============ 05 · THE FIRM ============ -->
<section class="scene scene--pad tint-ink" id="firm">
  <div class="wrap">
    <header class="split reveal" style="align-items:end;margin-bottom:var(--s7)">
      <div class="stack stack--tight">
        <p class="eyebrow">Paris Pullen LLC</p>
        <h2 class="display display--h2">The Firm</h2>
      </div>
      <div class="stack">
        <p class="lede">Brand development for a short list of people building something in Charlotte.</p>
        <p class="classified">Four files on the wall &#183; select one</p>
      </div>
    </header>

    <div class="studio reveal reveal-d1">
      <img src="assets/img/env-editorial.jpg"
           srcset="assets/img/env-editorial@sm.jpg 1200w, assets/img/env-editorial.jpg 2400w"
           sizes="100vw" alt="The studio wall, client work pinned and threaded"
           loading="lazy" width="2400" height="1339">
      <div class="studio__scrim"></div>

      <a class="pin" style="--x:8.3%;--y:22%;--i:0" href="casefiles.html#goodwill-grooming">
        <span class="pin__ping" aria-hidden="true"></span>
        <span class="pin__core" aria-hidden="true"></span>
        <span class="pin__tag">Goodwill Grooming</span>
      </a>
      <a class="pin" style="--x:17.3%;--y:19.3%;--i:1" href="casefiles.html#threepiece-entertainment">
        <span class="pin__ping" aria-hidden="true"></span>
        <span class="pin__core" aria-hidden="true"></span>
        <span class="pin__tag">Three Piece Entertainment</span>
      </a>
      <a class="pin" style="--x:12.3%;--y:41.7%;--i:2" href="casefiles.html#your-new-nail-tech">
        <span class="pin__ping" aria-hidden="true"></span>
        <span class="pin__core" aria-hidden="true"></span>
        <span class="pin__tag">Your New Nail Tech</span>
      </a>
      <a class="pin" style="--x:29.5%;--y:39.4%;--i:3" href="casefiles.html#burns-brims">
        <span class="pin__ping" aria-hidden="true"></span>
        <span class="pin__core" aria-hidden="true"></span>
        <span class="pin__tag">Burns &amp; Brims</span>
      </a>
    </div>

    <nav class="filemenu reveal reveal-d2" style="margin-top:var(--s8)" aria-label="Case files">
      <a class="filemenu__item" href="casefiles.html#goodwill-grooming">
        <span class="filemenu__no">File 01</span>
        <span class="filemenu__name">Goodwill Grooming</span>
        <span class="filemenu__kind">Barber &amp; recording artist</span>
        <span class="filemenu__state" data-state="live"><b>Live</b><span class="filemenu__open">Open &#8599;</span></span>
      </a>
      <a class="filemenu__item" href="casefiles.html#threepiece-entertainment">
        <span class="filemenu__no">File 02</span>
        <span class="filemenu__name">Three Piece Entertainment</span>
        <span class="filemenu__kind">Live music, production &amp; education</span>
        <span class="filemenu__state" data-state="live"><b>Live</b><span class="filemenu__open">Open &#8599;</span></span>
      </a>
      <a class="filemenu__item" href="casefiles.html#your-new-nail-tech">
        <span class="filemenu__no">File 03</span>
        <span class="filemenu__name">Your New Nail Tech</span>
        <span class="filemenu__kind">Luxury nail artistry</span>
        <span class="filemenu__state" data-state="out"><b>Proposal out</b><span class="filemenu__open">Open &#8599;</span></span>
      </a>
      <a class="filemenu__item" href="casefiles.html#burns-brims">
        <span class="filemenu__no">File 04</span>
        <span class="filemenu__name">Burns &amp; Brims</span>
        <span class="filemenu__kind">Millinery</span>
        <span class="filemenu__state" data-state="draft"><b>In the workroom</b><span class="filemenu__open">Open &#8599;</span></span>
      </a>
    </nav>

    <div class="split reveal" style="margin-top:var(--s8);border-top:1px solid var(--rule);padding-top:var(--s7)">
      <p class="pullquote">Most people are sold a proposal. These people were handed the finished thing.</p>
      <div class="stack">
        <p class="body">The site gets built <em>before</em> anyone is asked to pay for it. Nobody has to imagine what it might look like, or trust a mockup to become real. It already is one. The only question left is whether they want to own it.</p>
        <div class="hero__ctas">
          <a class="cta" href="casefiles.html"><span>All case files</span><span class="cta__arrow" aria-hidden="true">&#8594;</span></a>
          <a class="cta cta--ghost" href="mailto:hello@parispullen.com?subject=The%20Firm"><span>Start a conversation</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 06 · THE JOURNAL ============ -->
<section class="scene scene--pad" id="journal">
  <div class="wrap">
    <header class="split reveal" style="align-items:end;margin-bottom:var(--s7)">
      <div class="stack stack--tight">
        <p class="eyebrow">The Gentleman&#8217;s Journal</p>
        <h2 class="display display--h2">The Journal</h2>
      </div>
      <p class="body">Style, strategy, culture, Charlotte, music, fragrance, business, philosophy, life. Written the way it is lived &#8212; in short, useful pieces.</p>
    </header>

    <div class="jgrid reveal reveal-d1">
      <a class="jcard" data-cat="automotive" href="journal-karma-automotive.html">
        <div class="jcard__media"><img src="assets/img/press-karma@sm.jpg" alt="" loading="lazy"></div>
        <p class="jcard__cat">Automotive</p>
        <h3 class="jcard__title">Karma Automotive, and the Case for a Badge Nobody Recognizes</h3>
        <p class="jcard__stand">Nobody at the valet stand knows the name. That is the point &#8212; the car is explaining something to the one person in the room who does.</p>
        <p class="jcard__meta"><span>Vol. 11</span><span>4 min read</span></p>
      </a>
      <a class="jcard" data-cat="style" href="journal-suit-system.html">
        <div class="jcard__media"><img src="assets/img/paris-bespoke@sm.jpg" alt="" loading="lazy"></div>
        <p class="jcard__cat">Style</p>
        <h3 class="jcard__title">The Suit Is a System, Not an Outfit</h3>
        <p class="jcard__stand">Buy the jacket for the shoulders and the trouser for the break. Everything else is alteration, and alteration is where the money actually goes.</p>
        <p class="jcard__meta"><span>Vol. 02</span><span>4 min read</span></p>
      </a>
      <a class="jcard" data-cat="film" href="journal-the-gentlemen.html">
        <div class="jcard__media"><img src="assets/img/press-the-gentlemen@sm.jpg" alt="" loading="lazy"></div>
        <p class="jcard__cat">Film</p>
        <h3 class="jcard__title">On Being Underestimated: Notes on The Gentlemen</h3>
        <p class="jcard__stand">Every man in that film is underestimated by someone in the first ten minutes and finishes the movie having made them regret it. That is the whole genre, done properly.</p>
        <p class="jcard__meta"><span>Vol. 12</span><span>5 min read</span></p>
      </a>
      <a class="jcard" data-cat="gaming" href="journal-gta-6-anticipation.html">
        <div class="jcard__media"><img src="assets/img/press-gta6@sm.jpg" alt="" loading="lazy"></div>
        <p class="jcard__cat">Gaming</p>
        <h3 class="jcard__title">What Twelve Years of Waiting for GTA 6 Says About Attention</h3>
        <p class="jcard__stand">Nobody has played it. Everybody has an opinion about it. That gap is the most valuable real estate in entertainment right now, and almost nothing else on earth can hold it for twelve years.</p>
        <p class="jcard__meta"><span>Vol. 14</span><span>5 min read</span></p>
      </a>
      <a class="jcard" data-cat="music" href="journal-still-listening-to-iceman.html">
        <div class="jcard__media"><img src="assets/img/press-drake-iceman.jpg" alt="" loading="lazy"></div>
        <p class="jcard__cat">Music</p>
        <h3 class="jcard__title">Still Listening to Iceman</h3>
        <p class="jcard__stand">Some albums get a week. This one got moved into the rotation permanently, and nobody in the room has asked to change it since.</p>
        <p class="jcard__meta"><span>Vol. 19</span><span>3 min read</span></p>
      </a>
    </div>
    <a class="link-under" href="journal.html" style="margin-top:var(--s6);display:inline-block">All entries &#8594;</a>
  </div>
</section>


</main>

